{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Start Next.js Development Server",
			"type": "shell",
			"command": "pnpm dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Kill Node processes",
			"type": "shell",
			"command": "taskkill /f /im node.exe"
		},
		{
			"label": "Clean and Start Next.js",
			"type": "shell",
			"command": "rmdir /s /q .next & pnpm dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Test Login Flow",
			"type": "shell",
			"command": "node test-login.js"
		},
		{
			"label": "Test Login with curl",
			"type": "shell",
			"command": "curl -X POST -H \"Content-Type: application/json\" -d \"{\\\"usuario\\\":\\\"admin\\\",\\\"senha\\\":\\\"admin123\\\"}\" -c cookies.txt http://localhost:3000/api/login"
		},
		{
			"label": "Start Next.js Dev Server",
			"type": "shell",
			"command": "pnpm dev",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}