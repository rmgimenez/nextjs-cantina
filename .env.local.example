# Exemplo de .env.local para desenvolvimento
# Copie este arquivo para .env.local e atualize os valores sensíveis.
# Nunca comite seu .env.local no repositório.

# MySQL / Banco de dados
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sant31br

# JWT e autenticação
# Use uma string longa e única. Pode ser gerada com: openssl rand -hex 32
JWT_SECRET=troque_por_uma_chave_secreta_muito_longa
JWT_EXPIRES_IN=8h

# Cookies
# Nome do cookie HTTP Only usado para armazenar o JWT
COOKIE_NAME=nextjs_cantina_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# App
NEXT_PUBLIC_APP_NAME=Cantina Escolar
NEXT_PUBLIC_API_PREFIX=/api

# Email (opcional) - usado para envio de faturas/relatórios
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@smtp.com
SMTP_PASS=smtp_password
EMAIL_FROM="Cantina Escolar <no-reply@escola.com>"

# Configurações de desenvolvimento/infra
# Caso utilize o SENTRY, Google Analytics, etc., adicione aqui
# SENTRY_DSN=

# Docker / Produção
# Se estiver usando Docker ou Vercel, sobrescreva as variáveis conforme necessário

# Observações:
# - Valores booleanos (true/false) são strings aqui; o app deve convertê-los conforme necessário.
# - Altere JWT_SECRET para um valor seguro antes de subir para produção.
# - Para usar cookies seguros em produção, configure COOKIE_SECURE=true e sirva via HTTPS.
